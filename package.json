{
  "name": "playwright-ts-template",
  "version": "2.0.0",
  "private": true,
  "description": "Playwright + TypeScript project template with AI agent skills (wico) for Claude Code, Cursor, Copilot and Codex.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "report": "playwright show-report",
    "report:merge": "playwright merge-reports --reporter html ./all-blob-reports",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "pw:setup": "playwright install --with-deps",
    "skills:sync": "wico-playwright-agent-skills init --platforms claude,cursor,copilot --packs core,templates --project-name playwright-ts-template --base-url https://playwright.dev --fixture-import-path none --page-objects-dir src/pages --test-dir src/tests --yes --force --clean-legacy && playwright init-skills --loop claude && playwright init-skills --loop agents",
    "skills:check": "npm run skills:sync --silent && git diff --exit-code --stat -- .claude .agents .cursor .github/instructions .github/copilot-instructions.md"
  },
  "keywords": [
    "typescript",
    "playwright",
    "e2e",
    "testing",
    "template",
    "agent-skills",
    "wico-playwright-agent-skills"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.19.13",
    "eslint": "^10.10.0",
    "eslint-plugin-playwright": "^2.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "wico-playwright-agent-skills": "^2.0.0"
  }
}
